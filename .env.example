# EmailBot — copy to .env (never commit .env). Placeholders only.

NODE_ENV=development
LOG_LEVEL=debug

# API
API_HOST=0.0.0.0
# HTTP port. A platform-injected PORT takes precedence over API_PORT.
API_PORT=3000
# Required in production (https, not localhost). Local defaults are used in development.
API_PUBLIC_URL=http://localhost:3000
WEB_APP_URL=http://localhost:5173
# Required in production (comma separated)
CORS_ORIGINS=
# Behind a load balancer/reverse proxy: "true", hop count ("1") or proxy IPs/CIDRs.
# Needed so rate limiting sees the real client IP. Leave empty when not proxied.
TRUST_PROXY=
# Global requests per minute per client IP (sensitive routes have stricter limits)
RATE_LIMIT_MAX=300

# Supabase (server side). SERVICE ROLE KEY: backend/worker only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ATTACHMENTS_BUCKET=email-attachments

# Redis / BullMQ. Required in production (not localhost). Private network (e.g. Render Key Value
# internal URL): redis://; over the internet: rediss://. Eviction policy must be noeviction.
REDIS_URL=redis://localhost:6379

# Outbound HTTP timeouts (ms): Google/Microsoft and Supabase calls
PROVIDER_HTTP_TIMEOUT_MS=20000
SUPABASE_HTTP_TIMEOUT_MS=60000

# Same value for API and worker. Standard base64 of 32 random bytes (44 chars ending with "="):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# At least 32 random characters
OAUTH_STATE_SECRET=

# Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/gmail/callback
GMAIL_PUBSUB_VERIFICATION_TOKEN=

# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/oauth/microsoft/callback
MICROSOFT_TENANT=common
MICROSOFT_WEBHOOK_CLIENT_STATE=

# Worker
WORKER_EVENTS_CONCURRENCY=5
WORKER_PROCESSING_CONCURRENCY=10
WORKER_POLL_INTERVAL_MINUTES=5
# Attachments larger than this keep their metadata but their content is not stored
WORKER_MAX_ATTACHMENT_BYTES=26214400
# Worker health endpoint (GET /livez, GET /readyz). Disabled when neither this nor PORT is set.
WORKER_HEALTH_PORT=
WORKER_HEALTH_HOST=0.0.0.0

# Sentry (optional)
SENTRY_DSN=

# Web (public values only — never put secrets in VITE_*)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
# Required for production builds (NODE_ENV=production pnpm build fails without it)
VITE_API_URL=http://localhost:3000
