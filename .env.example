# EmailBot — copy to .env (never commit .env). Placeholders only.

NODE_ENV=development
LOG_LEVEL=debug

# API
API_HOST=0.0.0.0
# HTTP port. A platform-injected PORT takes precedence over API_PORT.
API_PORT=3000
# Required in production (https, not localhost). Local defaults are used in development.
API_PUBLIC_URL=http://localhost:3000
WEB_APP_URL=http://localhost:5173
# Required in production (comma separated)
CORS_ORIGINS=
# Behind a load balancer/reverse proxy: "true", hop count ("1") or proxy IPs/CIDRs.
# Needed so rate limiting sees the real client IP. Leave empty when not proxied.
TRUST_PROXY=
# Global requests per minute per client IP (sensitive routes have stricter limits)
RATE_LIMIT_MAX=300

# Supabase (server side). SERVICE ROLE KEY: backend/worker only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ATTACHMENTS_BUCKET=email-attachments

# Redis / BullMQ. Required in production (not localhost). Private network (e.g. Render Key Value
# internal URL): redis://; over the internet: rediss://. Eviction policy must be noeviction.
REDIS_URL=redis://localhost:6379

# Outbound HTTP timeouts (ms): Google/Microsoft and Supabase calls
PROVIDER_HTTP_TIMEOUT_MS=20000
SUPABASE_HTTP_TIMEOUT_MS=60000

# Same value for API and worker. Standard base64 of 32 random bytes (44 chars ending with "="):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# At least 32 random characters
OAUTH_STATE_SECRET=

# Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/gmail/callback
# Gmail push (users.watch -> Pub/Sub -> POST /webhooks/gmail). All optional: unset = polling only.
# Push subscription authentication (recommended): OIDC token for this audience + push service account.
GMAIL_PUBSUB_OIDC_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
# Legacy / additional check: shared token appended to the push URL (?token=...).
GMAIL_PUBSUB_VERIFICATION_TOKEN=
# Worker: topic the mailboxes watch, projects/<project>/topics/<topic>
# (grant Pub/Sub Publisher on it to gmail-api-push@system.gserviceaccount.com).
GMAIL_PUBSUB_TOPIC=

# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/oauth/microsoft/callback
MICROSOFT_TENANT=common
# Microsoft push (Graph change notifications -> POST /webhooks/microsoft). Optional: unset = polling only.
# API: serve the webhook routes and monitor the subscriptions (requires the Microsoft client above).
MICROSOFT_GRAPH_PUSH_ENABLED=false
# Worker: public HTTPS URL of the API webhook; lifecycle notifications go to <this URL>/lifecycle.
# Each subscription gets its own random clientState (no shared secret to configure).
MICROSOFT_GRAPH_NOTIFICATION_URL=
# GET /health/sync: minutes without a successful sync before an active mailbox counts as stale (default 20)
SYNC_HEALTH_STALE_MINUTES=20

# Worker
WORKER_EVENTS_CONCURRENCY=5
WORKER_PROCESSING_CONCURRENCY=10
# Recovery polling (catches missed pushes, expired watches, accounts without push)
WORKER_POLL_INTERVAL_MINUTES=5
# Push subscriptions (Gmail watches: 7 days; Microsoft Graph subscriptions: ~70 h) close to expiry are renewed by this job
WORKER_WATCH_RENEW_INTERVAL_MINUTES=60
# Attachments larger than this keep their metadata but their content is not stored
WORKER_MAX_ATTACHMENT_BYTES=26214400
# Worker health endpoint (GET /livez, GET /readyz). Disabled when neither this nor PORT is set.
WORKER_HEALTH_PORT=
WORKER_HEALTH_HOST=0.0.0.0

# Sentry (optional)
SENTRY_DSN=

# Web (public values only — never put secrets in VITE_*)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
# Required for production builds (NODE_ENV=production pnpm build fails without it)
VITE_API_URL=http://localhost:3000
