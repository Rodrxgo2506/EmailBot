{
  "name": "@emailbot/worker",
  "version": "0.1.0",
  "private": true,
  "description": "EmailBot background worker: provider events, email processing pipeline and notifications (BullMQ).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@emailbot/rules-engine": "workspace:*",
    "@emailbot/shared": "workspace:*",
    "@emailbot/types": "workspace:*",
    "@emailbot/validation": "workspace:*",
    "@sentry/node": "^11.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "bullmq": "^5.81.5",
    "dotenv": "^17.2.3",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
